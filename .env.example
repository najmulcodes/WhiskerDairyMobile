# Copy to .env for local development. Never commit .env.
# For cloud builds these live in EAS environment variables (preview + production).
# All EXPO_PUBLIC_* values are embedded in the app bundle: only put PUBLIC values here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
