{
  "expo": {
    "name": "Whisker Dairy",
    "slug": "whiskerdairy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whiskerdairy.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take pet photos",
        "NSPhotoLibraryUsageDescription": "Used to pick pet photos from your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fde3d1"
      },
      "package": "com.whiskerdairy.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Whisker Dairy to access your photos to set pet images.",
          "cameraPermission": "Allow Whisker Dairy to use the camera to take pet photos.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fddbd0",
          "image": "./assets/splash-full.png",
          "resizeMode": "cover",
          "android": {
            "backgroundColor": "#fddbd0",
            "image": "./assets/adaptive-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ]
    ],
    "scheme": "whiskerdairy",
    "extra": {
      "eas": {
        "projectId": "372acdec-7862-4c47-bacd-3ecf69c7f276"
      }
    },
    "owner": "shariarx6t9"
  }
}
